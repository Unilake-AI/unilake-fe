# Một URL backend cho Axios client và route handler Next.js.
# Development cho phép HTTP trên localhost hoặc địa chỉ IPv4 nội bộ.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Khi triển khai production, đặt URL backend HTTPS thực tế trước khi build.
# Có thể thêm /api/v1; ứng dụng chuẩn hóa để không lặp tiền tố.
# Bật khi chạy pnpm dev với backend từ xa chưa cho phép origin local qua CORS.
# NEXT_PUBLIC_API_PROXY=true

# Đặt IP ZeroTier của máy chạy frontend để pnpm dev lắng nghe tại IP đó.
# UNILAKE_DEV_HOST=10.96.134.223
